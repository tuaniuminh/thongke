{
  "build": {
    "distDir": "../www",
    "devPath": "http://localhost:3000",
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "FamiLife",
    "version": "4.3.258"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      },
      "fs": {
        "all": false,
        "writeFile": true,
        "scope": [
          "$TEMP/*"
        ]
      },
      "path": {
        "all": true
      },
      "process": {
        "exit": true
      },
      "dialog": {
        "all": true,
        "ask": true,
        "confirm": true,
        "message": true,
        "open": true,
        "save": true
      },
      "http": {
        "all": true,
        "request": true
      },
      "window": {
        "all": false,
        "close": true,
        "hide": true,
        "show": true,
        "maximize": true,
        "minimize": true,
        "unmaximize": true,
        "unminimize": true,
        "startDragging": true
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.familife.thongke",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico",
        "icons/icon.png"
      ],
      "resources": [],
      "publisher": "FamiLife Team",
      "windows": {
        "wix": {
          "language": {
            "vi-VN": {
              "localePath": "./wix/vi-VN.wxl"
            }
          },
          "bannerPath": "./wix/banner.bmp",
          "dialogImagePath": "./wix/dialog.bmp",
          "template": "./wix/main.wxs"
        }
      }
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "FamiLife - Thu Chi & Sức Khỏe Gia Đình",
        "width": 1280,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "decorations": false
      }
    ]
  }
}
