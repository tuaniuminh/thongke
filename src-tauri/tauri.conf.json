{
  "build": {
    "distDir": "../www",
    "devPath": "http://localhost:3000",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "package": {
    "productName": "FamiLife",
    "version": "4.6.2"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      },
      "fs": {
        "all": false,
        "writeFile": true,
        "scope": ["$TEMP/*"]
      },
      "path": {
        "all": true
      },
      "process": {
        "exit": true
      },
      "http": {
        "all": true,
        "request": true
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.familife.thongke",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico",
        "icons/icon.png"
      ],
      "resources": [],
      "publisher": "FamiLife Team",
      "windows": {
        "wix": {
          "language": {
            "en-US": {
              "localePath": "./wix/vi-VN.wxl"
            }
          },
          "bannerPath": "./wix/banner.bmp",
          "dialogImagePath": "./wix/dialog.bmp"
        }
      }
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "FamiLife - Thu Chi & Sức Khỏe Gia Đình",
        "width": 1280,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "maximized": true
      }
    ]
  }
}
