<?xml version="1.0" encoding="utf-8"?>
<WixLocalization Culture="en-US" Codepage="1258" xmlns="http://schemas.microsoft.com/wix/2006/localization">
  <!-- General UI Buttons -->
  <String Id="WixUIBack">&lt; Quay lại</String>
  <String Id="WixUINext">Tiếp theo &gt;</String>
  <String Id="WixUICancel">Hủy bỏ</String>
  <String Id="WixUIFinish">Hoàn tất</String>
  <String Id="WixUIInstall">Cài đặt</String>
  <String Id="WixUIExit">Thoát</String>
  <String Id="WixUIYes">Có</String>
  <String Id="WixUINo">Không</String>

  <!-- Welcome Dialog -->
  <String Id="WelcomeDlgTitle">{\WixUI_Font_Bigger}Chào mừng đến với trình cài đặt [ProductName]</String>
  <String Id="WelcomeDlgDescription">Trình cài đặt sẽ cài đặt [ProductName] trên máy tính của bạn. Bấm Tiếp theo để tiếp tục hoặc Hủy bỏ để thoát.</String>

  <!-- Destination Folder Dialog -->
  <String Id="InstallDirDlgTitle">{\WixUI_Font_Title}Chọn thư mục cài đặt</String>
  <String Id="InstallDirDlgDescription">Chọn thư mục để cài đặt ứng dụng.</String>
  <String Id="InstallDirDlgFolderLabel">Cài đặt [ProductName] vào thư mục:</String>
  <String Id="InstallDirDlgChange">Thay đổi...</String>

  <!-- Disk Cost Dialog -->
  <String Id="DiskCostDlgTitle">{\WixUI_Font_Title}Dung lượng đĩa yêu cầu</String>
  <String Id="DiskCostDlgDescription">Xem dung lượng đĩa trống trên máy tính.</String>

  <!-- Verify Ready Dialog -->
  <String Id="VerifyReadyDlgInstallTitle">{\WixUI_Font_Title}Sẵn sàng cài đặt</String>
  <String Id="VerifyReadyDlgInstallText">Nhấn Cài đặt để bắt đầu cài đặt [ProductName] trên máy tính của bạn. Nếu bạn muốn kiểm tra hoặc thay đổi bất kỳ thiết lập nào, hãy nhấn Quay lại.</String>

  <!-- Progress Dialog -->
  <String Id="ProgressDlgTitle">{\WixUI_Font_Title}Đang cài đặt [ProductName]</String>
  <String Id="ProgressDlgDescription">Vui lòng chờ trong khi trình cài đặt hoàn tất cài đặt [ProductName].</String>
  <String Id="ProgressDlgStatusLabel">Trạng thái:</String>

  <!-- Exit Dialog -->
  <String Id="ExitDialogTitle">{\WixUI_Font_Bigger}Hoàn tất cài đặt [ProductName]</String>
  <String Id="ExitDialogDescription">Ứng dụng [ProductName] đã được cài đặt thành công trên máy tính của bạn. Nhấn Hoàn tất để đóng trình cài đặt.</String>

  <!-- Maintenance Welcome Dialog -->
  <String Id="MaintenanceWelcomeDlgTitle">{\WixUI_Font_Bigger}Sửa chữa hoặc gỡ bỏ [ProductName]</String>
  <String Id="MaintenanceWelcomeDlgDescription">Trình cài đặt sẽ cho phép bạn sửa lỗi hoặc gỡ bỏ [ProductName] khỏi máy tính của bạn. Nhấn Tiếp theo để tiếp tục.</String>

  <!-- Maintenance Type Dialog -->
  <String Id="MaintenanceTypeDlgTitle">{\WixUI_Font_Title}Chọn thao tác</String>
  <String Id="MaintenanceTypeDlgDescription">Chọn thao tác bạn muốn thực hiện.</String>
  <String Id="MaintenanceTypeDlgRepairButton">Sửa chữa</String>
  <String Id="MaintenanceTypeDlgRepairText">Sửa các lỗi cài đặt ứng dụng bằng cách cài lại các file bị thiếu hoặc bị lỗi.</String>
  <String Id="MaintenanceTypeDlgRemoveButton">Gỡ bỏ</String>
  <String Id="MaintenanceTypeDlgRemoveText">Gỡ bỏ ứng dụng [ProductName] khỏi máy tính.</String>
</WixLocalization>
