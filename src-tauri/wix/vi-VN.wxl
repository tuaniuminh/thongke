<WixLocalization Culture="vi-VN" Codepage="65001" xmlns="http://schemas.microsoft.com/wix/2006/localization">
  <String Id="TauriLanguage">1066</String>
  <!-- General UI Buttons -->
  <String Id="WixUIBack">&lt; Quay lại</String>
  <String Id="WixUINext">Tiếp theo &gt;</String>
  <String Id="WixUICancel">Hủy bỏ</String>
  <String Id="WixUIFinish">Hoàn tất</String>
